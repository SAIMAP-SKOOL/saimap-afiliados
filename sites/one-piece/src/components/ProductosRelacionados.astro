---
import { getCollection } from 'astro:content';
import ProductCard from './ProductCard.astro';

interface Props {
  categoria: string;
  slugActual: string;
  limite?: number;
}
const { categoria, slugActual, limite = 3 } = Astro.props;

const relacionados = (await getCollection('resenas'))
  .filter((r) => r.data.categoria === categoria && r.slug !== slugActual)
  .sort((a, b) => b.data.fechaPublicacion.valueOf() - a.data.fechaPublicacion.valueOf())
  .slice(0, limite);
---
{relacionados.length > 0 && (
  <section class="relacionados">
    <h2>También te puede interesar</h2>
    <div class="grid-productos">
      {relacionados.map((r) => (
        <ProductCard
          slug={r.slug}
          titulo={r.data.titulo}
          imagen={r.data.imagen}
          precioAprox={r.data.precioAprox}
          valoracion={r.data.valoracion}
          resumen={r.data.resumen}
        />
      ))}
    </div>
  </section>
)}

<style>
  .relacionados {
    margin: 2.5rem 0;
  }
</style>
